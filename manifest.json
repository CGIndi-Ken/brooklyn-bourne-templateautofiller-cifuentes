{
  "manifest_version": 3,
  "name": "Brooklyn Bourne Autofiller",
  "version": "0.17.1",
  "description": "Saves product templates and fills the Dutchie create-product form, across one tab or many.",
  "permissions": ["storage"],
  "host_permissions": ["https://delta.backoffice.dutchie.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brooklyn Bourne Autofiller"
  },
  "commands": {
    "fill-all-tabs": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Fill every open Dutchie product tab, one by one"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://delta.backoffice.dutchie.com/*"],
      "js": ["fields.js", "category-pairings.js", "dom-utils.js", "fillers.js", "engine.js", "learn.js", "theme.js", "template-picker-style.js", "template-picker.js", "panel.js"]
    }
  ]
}
